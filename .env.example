# Free key from https://api.nasa.gov (DEMO_KEY allows about 10 requests per hour per IP).
# Copy to .env, which git ignores. On Netlify, set it under Environment variables.
VITE_NASA_API_KEY=DEMO_KEY

# Address used in shared links while the app runs locally: nobody else can open localhost.
# Deployed builds (production and deploy previews) share their own address.
VITE_PUBLIC_URL=https://apodgallery.netlify.app

# DeepL key for translating NASA's explanations into Spanish and Portuguese (https://www.deepl.com/pro-api).
# Server-side only: no VITE_ prefix, so it never reaches the browser. On Netlify, make it available to Functions.
# Without it the app shows NASA's original English text.
DEEPL_API_KEY=
